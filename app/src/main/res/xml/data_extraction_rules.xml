<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: what Android's own backup copies to the user's Google account and to a new device. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <!-- Holds a folder permission that is only valid on this device. -->
        <exclude domain="sharedpref" path="backup_settings.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="backup_settings.xml" />
    </device-transfer>
</data-extraction-rules>
